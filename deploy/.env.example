# Copy to /opt/taskop/.env on the server (mode 600) or to deploy/.env for a local run.
# deploy/bootstrap.sh fills in the generated secrets on a new server. Keep a copy in your password manager.

# Images to run. Deploys pin the commit: ghcr.io/sahmadpur/taskop-<name>:sha-<commit>.
LANDING_IMAGE=ghcr.io/sahmadpur/taskop-landing:latest
WEB_IMAGE=ghcr.io/sahmadpur/taskop-web:latest
API_IMAGE=ghcr.io/sahmadpur/taskop-api:latest

# Where the landing page's Login and Sign up links go (build argument, only used when building the image here).
PLATFORM_URL=https://admin.taskop.app

# Leave unset in production: Caddy then serves every site over HTTPS with Let's Encrypt certificates.
# Set to http for a local run, so the sites answer plain HTTP on port 80 without certificates.
#SITE_SCHEME=http

# Database passwords: hex only (they go into postgres:// URLs). openssl rand -hex 32
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
PLATFORM_DB_PASSWORD=

# Storage secret for SeaweedFS's S3 API (access key is "taskop"). openssl rand -hex 32
S3_SECRET_KEY=
# Phones and browsers upload here; presigned URLs are signed against this host.
S3_PUBLIC_ENDPOINT=https://files.taskop.app

# Ed25519 keys for the access tokens, one line each with \n escapes, in single quotes:
#   pnpm --filter @taskop/api keys:generate
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

WEB_URL=https://admin.taskop.app

# Email through Resend's SMTP: smtps://resend:<api-key>@smtp.resend.com:465
# Until it is set up, a placeholder keeps the API starting; invite and reset emails then fail and are logged.
SMTP_URL=smtp://localhost:25
MAIL_FROM=Taskop <no-reply@taskop.app>

LOG_LEVEL=info
