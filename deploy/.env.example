# Copy to /opt/taskop/.env on the server (mode 600) or to deploy/.env for a local run.
# Secrets for the API are added here with the remaining deployment work (§7 of the deployment plan).

# Image to run for the landing page. Deploys pin the commit: ghcr.io/sahmadpur/taskop-landing:sha-<commit>.
LANDING_IMAGE=ghcr.io/sahmadpur/taskop-landing:latest

# Where the landing page's Login and Sign up links go (build argument, only used when building the image here).
PLATFORM_URL=https://admin.taskop.app

# Leave unset in production: Caddy then serves every site over HTTPS with Let's Encrypt certificates.
# Set to http for a local run, so the sites answer plain HTTP on port 80 without certificates.
#SITE_SCHEME=http
