{
  "expo": {
    "name": "Taskop",
    "slug": "taskop",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "az.taskop.app",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#005E8C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "az.taskop.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "taskop",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#005E8C",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#021B2B"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Taskop yoxlamalar zamanı foto və video çəkmək üçün kameradan istifadə edir.",
          "microphonePermission": "Taskop video sübutlarda səsi yazmaq üçün mikrofondan istifadə edir.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Taskop sübut kimi qalereyadan foto və video seçmək üçün icazə istəyir."
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#005E8C",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "../../packages/brand/fonts/IBMPlexSans-Regular.ttf",
            "../../packages/brand/fonts/IBMPlexSans-Medium.ttf",
            "../../packages/brand/fonts/IBMPlexSans-SemiBold.ttf",
            "../../packages/brand/fonts/IBMPlexSans-Bold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "IBM Plex Sans",
                "fontDefinitions": [
                  {
                    "path": "../../packages/brand/fonts/IBMPlexSans-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "../../packages/brand/fonts/IBMPlexSans-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "../../packages/brand/fonts/IBMPlexSans-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "../../packages/brand/fonts/IBMPlexSans-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "../../packages/brand/fonts/IBMPlexSans-Regular.ttf",
              "../../packages/brand/fonts/IBMPlexSans-Medium.ttf",
              "../../packages/brand/fonts/IBMPlexSans-SemiBold.ttf",
              "../../packages/brand/fonts/IBMPlexSans-Bold.ttf"
            ]
          }
        }
      ],
      "./plugins/with-scene-lifecycle.js",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8634f3e-451c-4158-9272-703ae3226431"
      }
    },
    "owner": "s.ahmadpur"
  }
}
