---
import { MARK_CHECK, MARK_RING, MARK_VIEWBOX } from '@taskop/brand';
interface Props {
  /** Mark colour; the text follows the parent's colour. */
  mark?: string;
  size?: number;
  wordmark?: boolean;
  class?: string;
}
const { mark = 'var(--tp-primary)', size = 28, wordmark = true, class: className = '' } = Astro.props;
---

<span class={`logo ${className}`}>
  <svg viewBox={MARK_VIEWBOX} width={size} height={size} aria-hidden="true" focusable="false" style={`color:${mark}`}>
    <path d={MARK_RING} fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"></path>
    <path d={MARK_CHECK} fill="none" stroke="currentColor" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  {wordmark && <span class="logo-text">Taskop</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: inherit;
  }
  svg {
    flex: none;
  }
</style>
