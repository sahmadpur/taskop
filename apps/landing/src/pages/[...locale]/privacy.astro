---
import LegalPage from '../../components/LegalPage.astro';
import { isLanguage, type Language } from '../../lib/site';

export function getStaticPaths() {
  return [{ params: { locale: undefined } }, { params: { locale: 'en' } }, { params: { locale: 'ru' } }];
}
const { locale } = Astro.params;
const lang: Language = isLanguage(locale) ? locale : 'az';
---

<LegalPage lang={lang} kind="privacy" />
